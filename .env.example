# Existing Eclipse MQTT broker. No broker is managed in this project.
# MQTT_URL is required and has no default; it must include a scheme and host.
MQTT_URL=tcp://192.168.1.10:1883
# Set both or neither. Compose interpolates env_file values, so no value may
# contain '$'.
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=twilightzone-ups

MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_STATE_PREFIX=twilightzone/ups
DEVICE_ID=twilightzone_ups
DEVICE_NAME=Twilight Zone UPS
DEVICE_MODEL=EC850LCD

# Path to the CLI inside the container.
PWRSTAT_PATH=/usr/sbin/pwrstat
# Seconds allowed per pwrstat invocation; must be below POLL_INTERVAL.
PWRSTAT_TIMEOUT=10
# Seconds between samples.
POLL_INTERVAL=15

# Compose-only: host file bind-mounted over PWRSTAT_PATH. Uncomment to override.
# PWRSTAT_HOST_PATH=/usr/sbin/pwrstat
