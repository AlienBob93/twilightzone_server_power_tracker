# Copy to .env to override the docker-compose defaults.
# NUT_HOST must be reachable from inside the container. On Linux the compose
# file maps host.docker.internal to the host gateway automatically.
NUT_HOST=host.docker.internal
NUT_PORT=3493
# Leave empty to auto-detect the first UPS exposed by upsd.
NUT_UPS=
LOG_LEVEL=info
